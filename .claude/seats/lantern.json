{
  "env": {
    "GIT_AUTHOR_NAME": "lantern",
    "GIT_AUTHOR_EMAIL": "lantern@lattice",
    "GIT_COMMITTER_NAME": "lantern",
    "GIT_COMMITTER_EMAIL": "lantern@lattice"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(/1.presence-minds-awareness/**)",
      "Write(/1.presence-minds-awareness/**)"
    ],
    "deny": [
      "Edit(manifest.live.md)",
      "Write(manifest.live.md)",
      "Edit(log.session*)",
      "Write(log.session*)",
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)",
      "Edit(/server.py)",
      "Write(/server.py)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python .claude/seats/statusline.py lantern \"1 presence-minds-awareness\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/User/Documents/0000000/mind not map/.claude/seats/halt.py\" lantern"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/User/Documents/0000000/mind not map/.claude/seats/wake.py\" lantern"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/User/Documents/0000000/mind not map/.claude/seats/goodnight.py\" lantern"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/User/Documents/0000000/mind not map/.claude/seats/witness.py\""
          }
        ]
      }
    ]
  }
}