{
  "env": {
    "GIT_AUTHOR_NAME": "lantern",
    "GIT_AUTHOR_EMAIL": "lantern@lattice",
    "GIT_COMMITTER_NAME": "lantern",
    "GIT_COMMITTER_EMAIL": "lantern@lattice"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(/1.v.d.o.0333.presence-minds-awareness/**)",
      "Write(/1.v.d.o.0333.presence-minds-awareness/**)"
    ],
    "deny": [
      "Edit(manifest.live.md)",
      "Write(manifest.live.md)",
      "Edit(log.session*)",
      "Write(log.session*)",
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)",
      "Edit(/server.py)",
      "Write(/server.py)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python .claude/seats/statusline.py lantern \"1 presence-minds-awareness\""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python .claude/seats/witness.py" }
        ]
      }
    ]
  }
}
