{
  "env": {
    "GIT_AUTHOR_NAME": "clerk",
    "GIT_AUTHOR_EMAIL": "clerk@lattice",
    "GIT_COMMITTER_NAME": "clerk",
    "GIT_COMMITTER_EMAIL": "clerk@lattice"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(/2.m.g.c.0667.structure-maintains-order/**)",
      "Write(/2.m.g.c.0667.structure-maintains-order/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Edit(/server.py)",
      "Write(/server.py)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python .claude/seats/statusline.py clerk \"2 structure-maintains-order\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/User/Documents/0000000/mind not map/.claude/seats/wake.py\" clerk"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/User/Documents/0000000/mind not map/.claude/seats/witness.py\""
          }
        ]
      }
    ]
  }
}