# vault config: only deliberate files tracked; the app's own churn stays off the trail
# (graph.json carries live view state — zoom/pane — so it churns per use; ignored,
#  deliberate baseline preserved in git history @ 162e391)
.obsidian/*
!.obsidian/app.json
.trash/

# the shelves: contents untracked (source texts are replaceable, not repo history);
# library.index at the front desk is the tracked record of what's shelved
library/texts/
